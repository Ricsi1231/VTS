    MOVE_TO_PNEUMATIC_TABLE := 2,
    PLACE_PART_TO_PNEUMATIC_TABLE := 3,
    ROTATE_PART_TO_CHECK_FOR_MARK := 4,
    CHECK_FOR_MARK := 5,
    MARK_PART := 6,
    ROTATE_PART_TO_MANIPULATOR := 7,
    TRANSFER_MANIPULATOR := 8,
    CONVYER_START := 9,
    CONVEYER_STOP := 10,
    CHECK_FOR_PART_COUNT := 11,
    CHANGE_ROBOT_TOOLPLACE := 12,
